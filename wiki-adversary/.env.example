# Provided at hackathon kickoff
LLM_API_KEY=

# Local Redis (start with: docker run -p 6379:6379 redis:latest)
REDIS_URL=redis://localhost:6379

# Optional model override (defaults to cognee's choice)
# gpt-5.4-nano is what the live demo currently runs on — more devious
# attacker output, more decisive judge.
LLM_MODEL=gpt-5.4-nano
